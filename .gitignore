.DS_STORE
Thumbs.db
/demo-missions/spikes/
/.superpowers/
/.drafts/

# Editors
/.vscode/
/.idea/

# MkDocs build output — published to the gh-pages branch by CI, not committed here.
/site/

# Test coverage — written by luacov into the directory the suite was run from.
/luacov.stats.out
/luacov.report.out

# Build output: the deliverable, built by build-tools/build-compiled-script.py.
/build/

# Lint tools, fetched at pinned versions by build-tools/lint.sh.
/.tools/

# Python bytecode, from build-tools/*.py
__pycache__/
*.pyc

# Claude Code: per-machine overrides stay local
.claude/settings.local.json

# In-sim suite: hotload's mailbox, the working copies of the missions.
/test/insim/dcs-hotload/user-inbox/*
!/test/insim/dcs-hotload/user-inbox/.gitkeep
/test/insim/dcs-hotload/user-outbox/*
!/test/insim/dcs-hotload/user-outbox/.gitkeep
/test/insim/miz/*
!/test/insim/miz/*.template.miz
